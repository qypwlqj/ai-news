{
  "name": "ai-news",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:weapp",
    "dev:weapp": "npm run dev:weapp -w @ai-news/miniapp",
    "dev:h5": "npm run dev:h5 -w @ai-news/miniapp",
    "dev:server": "npm run dev -w @ai-news/server",
    "start:server": "npm run start -w @ai-news/server",
    "build": "npm run build:weapp && npm run build:server",
    "build:weapp": "npm run build:weapp -w @ai-news/miniapp",
    "build:h5": "npm run build:h5 -w @ai-news/miniapp",
    "build:server": "npm run build -w @ai-news/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "verify:weapp": "node scripts/verify-weapp.mjs"
  }
}
